# Generated by the engine. Never commit these.
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/*
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Keep the files the engine reads from Build/ (icons, pak lists).
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built lighting data for maps
*_BuiltData.uasset

# Project files the engine can regenerate
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/
.vsconfig
.idea/
.vscode/

# Compiled objects, libraries and executables
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.a
*.lib
*.exe
*.app
*.ipa

# OS files
.DS_Store
Thumbs.db

# Agent tooling
# ue-* skills are symlinks to a local clone (see Scripts/link-ue-skills.sh).
.claude/skills/ue-*
.claude/settings.local.json
CLAUDE.local.md

# Local staging for source art that is not ready to import
SourceArt/Incoming/
